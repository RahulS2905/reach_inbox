# --- Core ---
NODE_ENV=development
APP_BASE_URL=http://localhost:5173
API_PORT=4000
API_BASE_URL=http://localhost:4000

# --- Database ---
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# --- Sessions / crypto ---
SESSION_SECRET=replace-with-32-byte-random-hex
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-random-hex

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# --- Slack OAuth ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_CALLBACK_URL=http://localhost:4000/api/slack/oauth/callback

# --- Ethereal SMTP (leave blank to auto-create a test account on worker boot) ---
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Scheduling / rate limiting ---
WORKER_CONCURRENCY=5
MIN_SEND_INTERVAL_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# Log level (e.g. info, debug, error)
LOG_LEVEL=info

# Add your Google OAuth, Slack, SMTP, Database, Redis, and ElasticSearch credentials below
# ...
